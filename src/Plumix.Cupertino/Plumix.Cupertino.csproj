<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Plumix.Cupertino</PackageId>
        <!-- Versioned after the cupertino_ui pub package it ports (src/Versions.props, docs/VERSIONING.md). -->
        <Version>$(PlumixCupertinoVersion)</Version>
        <Description>Cupertino (iOS-style) component library for Plumix — a Flutter-inspired UI framework for .NET. Includes iOS-style buttons, navigation bars, and Cupertino theming.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Plumix\Plumix.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Plumix.Tests" />
        <InternalsVisibleTo Include="Plumix.Material" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <!-- Package assets, addressed as packages/<assembly>/<path>: the logical name is the path, which
             PlatformAssetBundle (src/Plumix/Rendering/ImageProvider.cs) looks up before asking the host. -->
        <EmbeddedResource Include="Assets\Fonts\CupertinoIcons.ttf" LogicalName="Assets/Fonts/CupertinoIcons.ttf" />
        <None Include="Assets\Fonts\CupertinoIcons_LICENSE.txt" Pack="true" PackagePath="licenses" />
    </ItemGroup>

</Project>
