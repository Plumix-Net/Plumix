<Project Sdk="Microsoft.NET.Sdk">

    <!-- Stage 4 prototype (docs/product/avalonia-free-core.md): the native Android host without Avalonia,
         rendering through Impeller (GLES on EGL): ImpellerActivity, the raster thread, input, IME, images and
         system fonts. Branch proto/impeller only; never packed. libimpeller.so comes with Plumix.NImpeller.Native. -->
    <PropertyGroup>
        <TargetFramework>net11.0-android</TargetFramework>
        <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Android's implicit namespaces clash with Plumix widget names (ListView, Switch, Dialog...). -->
        <Using Remove="Android.Widget" />
        <Using Remove="Android.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Plumix.Impeller\Plumix.Impeller.csproj" />
    </ItemGroup>

</Project>
