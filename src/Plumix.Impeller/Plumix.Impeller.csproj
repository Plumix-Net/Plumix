<Project Sdk="Microsoft.NET.Sdk">

    <!-- Stage 4 prototype (docs/product/avalonia-free-core.md): an Impeller backend for the core's seams.
         Not packed until the native host's publishing gates. NImpeller comes from the Plumix.NImpeller package (the
         Plumix-Net/NImpeller fork). -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Plumix\Plumix.csproj" />
        <PackageReference Include="HarfBuzzSharp" />
        <PackageReference Include="Plumix.NImpeller" />
    </ItemGroup>

    <!-- Fragment programs (ImpellerShaders): runtime-stage bundles of the framework's pinned shader sources, compiled
         by scripts/compile_impeller_shaders.py with the impellerc of Plumix.NImpeller's pinned tools archive, each
         embedded with its GLSL source (the backend matches core programs by its uniforms). -->
    <ItemGroup>
        <EmbeddedResource Include="Shaders\*.frag;Shaders\*.iplr" LogicalName="Plumix.Impeller.Shaders.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Plumix.Impeller.Android" />
        <InternalsVisibleTo Include="Plumix.Impeller.Tests" />
        <InternalsVisibleTo Include="Plumix.Sample.Impeller.Android" />
    </ItemGroup>

</Project>
