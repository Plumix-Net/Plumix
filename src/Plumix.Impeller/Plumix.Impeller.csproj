<Project Sdk="Microsoft.NET.Sdk">

    <!-- The Impeller backend behind the core's seams, shared by the native hosts: display-list playback, glyph-run
         text over HarfBuzz, images, fragment programs, the engine's pointer packet converter and APNG codec.
         NImpeller comes from the Plumix.NImpeller package (the Plumix-Net/NImpeller fork). -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Trim/AOT analyzers keep the assembly Native-AOT-clean (consumers publish mobile heads with PublishAot). -->
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Plumix.Impeller</PackageId>
        <Description>Impeller rendering backend for Plumix's native hosts — display lists, layers, HarfBuzz text as Impeller glyph runs, images and fragment programs on Flutter's renderer, through NImpeller (Plumix.NImpeller).</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Plumix\Plumix.csproj" />
        <PackageReference Include="HarfBuzzSharp" />
        <PackageReference Include="Plumix.NImpeller" />
    </ItemGroup>

    <!-- Fragment programs (ImpellerShaders): runtime-stage bundles of the framework's pinned shader sources, compiled
         by scripts/compile_impeller_shaders.py with the impellerc of Plumix.NImpeller's pinned tools archive, each
         embedded with its GLSL source (the backend matches core programs by its uniforms). -->
    <ItemGroup>
        <EmbeddedResource Include="Shaders\*.frag;Shaders\*.iplr" LogicalName="Plumix.Impeller.Shaders.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Plumix.Android" />
        <InternalsVisibleTo Include="Plumix.iOS" />
        <InternalsVisibleTo Include="Plumix.Impeller.Tests" />
        <InternalsVisibleTo Include="Plumix.Sample.Android" />
    </ItemGroup>

</Project>
