<Project Sdk="Microsoft.NET.Sdk">

    <!-- Stage 4 prototype (docs/product/avalonia-free-core.md): an Impeller backend for the core's seams.
         Branch proto/impeller only; never packed. NImpeller comes from the nimpeller-src checkout (AGENTS.md). -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Plumix\Plumix.csproj" />
        <PackageReference Include="HarfBuzzSharp" />
        <ProjectReference Include="..\..\nimpeller-src\src\NImpeller\NImpeller.csproj" />
    </ItemGroup>

    <!-- Fragment programs (ImpellerShaders): the pinned Flutter sources of the shaders the framework ships, compiled
         by the Flutter SDK's impellerc (flutter-src, AGENTS.md) into runtime-stage bundles and embedded with their
         sources. Without the SDK the programs are missing and draw nothing. -->
    <PropertyGroup>
        <FlutterEngineArtifacts>$(MSBuildThisFileDirectory)..\..\flutter-src\bin\cache\artifacts\engine\darwin-x64\</FlutterEngineArtifacts>
        <Impellerc>$(FlutterEngineArtifacts)impellerc</Impellerc>
        <ImpellerShaderDirectory>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)shaders\</ImpellerShaderDirectory>
    </PropertyGroup>

    <ItemGroup>
        <ImpellerShader Include="..\..\material-ui-src\lib\src\shaders\ink_sparkle.frag" />
    </ItemGroup>

    <Target Name="_CompileImpellerShaders" BeforeTargets="BeforeBuild" Condition="Exists('$(Impellerc)')">
        <MakeDir Directories="$(ImpellerShaderDirectory)" />
        <Exec Command="&quot;$(Impellerc)&quot; --runtime-stage-gles --runtime-stage-gles3 --runtime-stage-vulkan --iplr --input=&quot;%(ImpellerShader.FullPath)&quot; --sl=&quot;$(ImpellerShaderDirectory)%(ImpellerShader.Filename).frag.iplr&quot; --spirv=&quot;$(ImpellerShaderDirectory)%(ImpellerShader.Filename).spv&quot; --include=&quot;$(FlutterEngineArtifacts)shader_lib&quot;" />
        <ItemGroup>
            <_ImpellerShaderBundle Include="@(ImpellerShader->'$(ImpellerShaderDirectory)%(Filename).frag.iplr')" />
            <EmbeddedResource Include="@(ImpellerShader)" LogicalName="Plumix.Impeller.Shaders.%(ImpellerShader.Filename).frag" />
            <EmbeddedResource Include="@(_ImpellerShaderBundle)" LogicalName="Plumix.Impeller.Shaders.%(_ImpellerShaderBundle.Filename).iplr" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <InternalsVisibleTo Include="Plumix.Impeller.Android" />
        <InternalsVisibleTo Include="Plumix.Sample.Impeller.Android" />
    </ItemGroup>

</Project>
