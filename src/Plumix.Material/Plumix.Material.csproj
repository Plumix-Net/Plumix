<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Trim/AOT analyzers keep the assembly Native-AOT-clean (consumers publish mobile heads with PublishAot). -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Plumix.Material</PackageId>
        <!-- Versioned after the material_ui pub package it ports (src/Versions.props, docs/VERSIONING.md). -->
        <Version>$(PlumixMaterialVersion)</Version>
        <Description>Material Design 3 component library for Plumix — a Flutter-inspired UI framework for .NET. Includes buttons, app bars, navigation, dialogs, and full Material theming.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MaterialTheming" />
        <ProjectReference Include="..\Plumix.Cupertino\Plumix.Cupertino.csproj" />
        <ProjectReference Include="..\Plumix\Plumix.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Plumix.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <!-- Package assets, addressed as packages/<assembly>/<path>: the logical name is the path, which
             PlatformAssetBundle (src/Plumix/Rendering/ImageProvider.cs) looks up before asking the host. -->
        <EmbeddedResource Include="Assets\Fonts\MaterialIcons-Regular.otf" LogicalName="Assets/Fonts/MaterialIcons-Regular.otf" />
        <None Include="Assets\Fonts\MaterialIcons_LICENSE.txt" Pack="true" PackagePath="licenses" />
        <EmbeddedResource Include="Assets\Shaders\ink_sparkle.sksl" />
        <None Update="Assets\Shaders\LICENSE" Pack="true" PackagePath="licenses\Flutter-Shaders-LICENSE.txt" />
    </ItemGroup>

</Project>
