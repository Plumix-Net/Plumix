<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- VersionOverride: the compat CI job runs the suite on a newer Avalonia than the one Plumix
         compiled against (see AvaloniaTestVersion in Directory.Packages.props). -->
    <PackageReference Include="Avalonia" VersionOverride="$(AvaloniaTestVersion)" />
    <PackageReference Include="Avalonia.Skia" VersionOverride="$(AvaloniaTestVersion)" />
    <PackageReference Include="Avalonia.HarfBuzz" VersionOverride="$(AvaloniaTestVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures/AnimatedImages/*" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Fixtures/Fonts/*.ttf" />
    <EmbeddedResource Include="Fixtures/Shaders/*.sksl" />
    <ProjectReference Include="../Plumix/Plumix.csproj" />
    <ProjectReference Include="../Plumix.Cupertino/Plumix.Cupertino.csproj" />
    <ProjectReference Include="../Plumix.Material/Plumix.Material.csproj" />
    <ProjectReference Include="..\Sample\Plumix.Sample\Plumix.Sample.csproj" />
  </ItemGroup>
</Project>
