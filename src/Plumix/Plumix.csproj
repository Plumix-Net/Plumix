<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>Plumix</PackageId>
        <Description>A Flutter-inspired declarative UI framework for .NET. Provides the widget/element/render-object architecture, state management and the render pipeline with Flutter's own API shapes; run it with a host package such as Plumix.Avalonia.</Description>
    </PropertyGroup>

    <!-- No package references: the core names no host or drawing-backend type
         (docs/product/avalonia-free-core.md; HostDependencyBudgetTests keeps it at zero). -->

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="UI\Assets\FlutterTest.ttf" LogicalName="Plumix.UI.Assets.FlutterTest.ttf" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Plumix.Tests" />
        <InternalsVisibleTo Include="Plumix.Avalonia" />
        <InternalsVisibleTo Include="Plumix.Impeller" />
        <InternalsVisibleTo Include="Plumix.Impeller.Android" />
        <InternalsVisibleTo Include="Plumix.Impeller.Tests" />
        <InternalsVisibleTo Include="Plumix.Sample.Impeller.Android" />
        <InternalsVisibleTo Include="Plumix.Material" />
        <InternalsVisibleTo Include="Plumix.Cupertino" />
        <InternalsVisibleTo Include="Plumix.iOS" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Widgets\Framework.Widget.cs">
            <DependentUpon>Framework.cs</DependentUpon>
        </Compile>
        <Compile Update="Widgets\Framework.Element.cs">
            <DependentUpon>Framework.cs</DependentUpon>
        </Compile>
        <Compile Update="Widgets\Framework.BuildOwner.cs">
            <DependentUpon>Framework.cs</DependentUpon>
        </Compile>
        <Compile Update="Rendering\Object.RenderObject.cs">
            <DependentUpon>Object.cs</DependentUpon>
        </Compile>
        <Compile Update="Rendering\Box.RenderBox.cs">
            <DependentUpon>Box.cs</DependentUpon>
        </Compile>
        <Compile Update="Rendering\Flex.RenderFlex.cs">
            <DependentUpon>Flex.cs</DependentUpon>
        </Compile>
        <Compile Update="Rendering\Object.PaintingContext.cs">
            <DependentUpon>Object.cs</DependentUpon>
        </Compile>
    </ItemGroup>

</Project>
