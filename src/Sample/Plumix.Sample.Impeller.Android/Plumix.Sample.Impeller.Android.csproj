<Project Sdk="Microsoft.NET.Sdk">

    <!-- Stage 4 prototype (docs/product/avalonia-free-core.md): the Sample gallery on the native Android host
         without Avalonia (src/Plumix.Impeller.Android), rendering through Impeller. Branch proto/impeller only. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0-android</TargetFramework>
        <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
        <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationId>com.plumix.impeller</ApplicationId>
        <ApplicationTitle>Plumix Impeller</ApplicationTitle>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- The Sample gallery's widget code, compiled into this host (its App.axaml.cs is the Avalonia bootstrap). -->
    <ItemGroup>
        <Compile Include="..\Plumix.Sample\**\*.cs"
                 Exclude="..\Plumix.Sample\App.axaml.cs;..\Plumix.Sample\obj\**;..\Plumix.Sample\bin\**"
                 LinkBase="Sample" />
        <PackageReference Include="Plumix.Bloc" />
        <!-- Android's implicit namespaces clash with Plumix widget names (ListView, Switch, Dialog...). -->
        <Using Remove="Android.Widget" />
        <Using Remove="Android.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Plumix.Impeller.Android\Plumix.Impeller.Android.csproj" />
        <ProjectReference Include="..\..\Plumix.Material\Plumix.Material.csproj" />
    </ItemGroup>

    <!-- Packages libimpeller.so per RuntimeIdentifier from nimpeller-src/external/impeller_sdk. -->
    <Import Project="..\..\..\nimpeller-src\samples\Sandbox.Android\Impeller.targets" />

</Project>
